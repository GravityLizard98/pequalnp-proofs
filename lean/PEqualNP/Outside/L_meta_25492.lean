theorem calculated : (circuit.gates.foldl hcsStep raw).getD circuit.output 0 = table := by
  decide +kernel

theorem target_spec : ∀ u v : Fin 32, table.getLsbD (32*u.val + v.val) = Nat.testBit 0x10f0105020508c18a6860e806ac8ae9e28c180f8553080be50ddf79e6891afb9540580824024148640d9d7bca88c229000b07351f447af4000b014586ab804a45e55690e10a0073568658ad53050a01024508c1a7455fba3d65a6f1a6879a8a50004140274d0fd25a88822901b7982bb1d58483ac443c8c259092a9df2bc7573 (32*u.val+v.val) := by
  decide +kernel

theorem rb : PEqualNP.MetaComplexity.NestedCover.ReadsBack 64 circuit := by
  unfold PEqualNP.MetaComplexity.NestedCover.ReadsBack PEqualNP.MetaComplexity.NestedCover.gateAt
  decide +kernel

