set_option maxRecDepth 100000 in
theorem PEqualNP.Outside.L_meta_25492 : ∃ C : PEqualNP.CircuitLowerBounds.Circuit,
  PEqualNP.MetaComplexity.Monotone2 C ∧
  C.size ≤ 201 ∧
  PEqualNP.MetaComplexity.NestedCover.ReadsBack 64 C ∧
  PEqualNP.Represents.Represents
    (fun u v : Fin 32 => Nat.testBit 0x10f0105020508c18a6860e806ac8ae9e28c180f8553080be50ddf79e6891afb9540580824024148640d9d7bca88c229000b07351f447af4000b014586ab804a45e55690e10a0073568658ad53050a01024508c1a7455fba3d65a6f1a6879a8a50004140274d0fd25a88822901b7982bb1d58483ac443c8c259092a9df2bc7573 (32 * u.val + v.val)) C := by
  refine ⟨circuit, mono, by decide +kernel, rb, ?_⟩
  intro u v
  let r := 32 * u.val + v.val
  have hr : r < 1024 := by dsimp [r]; omega
  have hbits := hcsFoldBits raw ⟨r,hr⟩ circuit.gates fan
  change (circuit.gates.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun k => w.getD k false)])
    (PEqualNP.Represents.oneEach u v)).getD circuit.output false = _
  rw [← raw_spec u v, ← hbits, ← hcsGetDBit, calculated]
  exact target_spec u v
