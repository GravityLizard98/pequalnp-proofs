theorem zmem (l : List ℕ) : ∀ (k i : ℕ), i < l.length → (l.getD i 0, k + i) ∈ l.zipIdx k := by
  induction l with
  | nil => intro k i hi; simp at hi
  | cons a l ih =>
    intro k i hi
    rw [List.zipIdx_cons]
    cases i with
    | zero => simp
    | succ i =>
      have h := ih (k + 1) i (by simpa using hi)
      have e : k + 1 + i = k + (i + 1) := by omega
      rw [e] at h
      apply List.mem_cons_of_mem
      simpa using h

theorem chunk_ok (w : List ℕ) (k : ℕ) (h : ((w.zipIdx k).all fun p => chk p.2 p.1) = true)
    (x : ℕ) (h1 : k ≤ x) (h2 : x < k + w.length) : chk x (w.getD (x - k) 0) = true := by
  rw [List.all_eq_true] at h
  have hm := zmem w k (x - k) (by omega)
  have e : k + (x - k) = x := by omega
  rw [e] at hm
  exact h _ hm

